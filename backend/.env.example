# Environment Configuration for JK Montessori School ERP Backend
# Location: Subhash Chowk, Block Ghughli, District Maharajganj, UP
# Developed by Bhaskar Gautam

# Database Configuration (MySQL / MariaDB in XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jkmontessori_erp
DB_USER=root
DB_PASSWORD=

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/jkmontessori_erp/backend/public
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session & Security Settings
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
